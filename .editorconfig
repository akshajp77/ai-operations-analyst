# Editor defaults applied before any formatter runs.
#
# Prettier and Ruff enforce these in CI, but .editorconfig fixes them at the
# keystroke, which keeps whitespace-only noise out of diffs.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{md,mdx}]
# Two trailing spaces are a hard line break in Markdown; stripping them
# silently changes rendered output.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{yml,yaml}]
indent_size = 2
