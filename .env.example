# Root environment file — consumed by docker-compose.yml only.
#
#   cp .env.example .env
#
# Service-level configuration lives in backend/.env.example and
# frontend/.env.example. This file holds just the values Compose itself needs
# to interpolate before any container starts.

# --- PostgreSQL container ---------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_ops_analyst

# --- Compose-wide overrides -------------------------------------------------
# `console` is readable locally; deployed environments set `json`.
LOG_FORMAT=console
