# ---------------------------------------------------------------------------
# Secrets — first, because this is the section that matters.
#
# A committed .env is a credential rotation, an incident report, and a bad
# afternoon. Only *.example files, which contain placeholders, are tracked.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
secrets/
credentials.json
service-account*.json

# ---------------------------------------------------------------------------
# Python / backend
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Tooling caches
.mypy_cache/
.dmypy.json
.ruff_cache/
.pytest_cache/
.hypothesis/
.tox/
.nox/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ---------------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*

# Next.js
.next/
out/
next-env.d.ts
.vercel/

# Build output
build/
dist/

# Test output
coverage/
playwright-report/
blob-report/
test-results/
.nyc_output/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Caches
.eslintcache
.turbo/
*.tsbuildinfo

# ---------------------------------------------------------------------------
# Application data
#
# Uploaded datasets and generated reports are customer data. They must never
# reach the repository, even from a local experiment.
# ---------------------------------------------------------------------------
.data/
uploads/
*.duckdb
*.duckdb.wal
*.sqlite3
*.db

# Generated artefacts. The OpenAPI document and the TypeScript types derived
# from it are build outputs, regenerated by `make types`. Committing them
# invites a merge conflict on every backend change.
packages/shared-types/openapi.json
frontend/src/types/api.generated.ts

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.idea/
*.swp
*.swo
*~

# VS Code: share the team's recommended settings, ignore personal state.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ---------------------------------------------------------------------------
# Local scratch
# ---------------------------------------------------------------------------
tmp/
temp/
scratch/
*.local
