# Backend configuration — copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored. Every variable here maps to a field on a Settings
# class in app/core/config.py; that file is the authoritative reference for
# types, defaults, and validation rules.
#
# Nested sections use their own prefix (DATABASE_, OPENAI_, STORAGE_, INGEST_).

# --- Identity ---------------------------------------------------------------
APP_NAME="AI Operations Analyst"
ENVIRONMENT=local              # local | test | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The application refuses to boot in staging/production while this is the
# placeholder value.
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_TTL_MINUTES=60

# Comma-separated. Never "*" in a deployed environment — boot validation
# rejects it.
CORS_ORIGINS=http://localhost:3000

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=console             # console for local readability, json when deployed

# --- Database ---------------------------------------------------------------
# Must use the postgresql+asyncpg driver; a sync DSN is rejected at boot.
# Host is `db` under Docker Compose, `localhost` when running natively.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_ops_analyst
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
# Logs every statement with its bound parameters. Never enable when deployed.
DATABASE_ECHO_SQL=false

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=sk-replace-with-your-key
OPENAI_MODEL=gpt-4.1
OPENAI_FAST_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=3
OPENAI_MAX_OUTPUT_TOKENS=8192

# --- Storage ----------------------------------------------------------------
STORAGE_BACKEND=local          # local | s3
STORAGE_LOCAL_PATH=./.data/uploads
# Required when STORAGE_BACKEND=s3:
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
STORAGE_SIGNED_URL_TTL_SECONDS=3600

# --- Ingestion limits -------------------------------------------------------
# Blast-radius controls. One unbounded upload can exhaust memory for every
# tenant on the node.
INGEST_MAX_UPLOAD_BYTES=209715200   # 200 MiB
INGEST_MAX_ROWS=5000000
INGEST_MAX_COLUMNS=512
# How many sample rows the AI layer may see. The model reasons over computed
# statistics, not raw data — this is a data-minimisation control as much as a
# cost control.
INGEST_AI_SAMPLE_ROWS=50
