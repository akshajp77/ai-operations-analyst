# Frontend configuration — copy to `.env.local` and adjust.
#
#   cp .env.example .env.local
#
# THE RULE THAT MATTERS: any variable prefixed NEXT_PUBLIC_ is inlined into
# the JavaScript bundle sent to the browser. It is public. Putting an API key
# behind that prefix publishes it to every visitor. Server-only values omit
# the prefix and are readable exclusively from server components, route
# handlers, and server actions.

# --- Public (shipped to the browser) ----------------------------------------
# Base URL the browser uses to reach the API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Server-only (never sent to the browser) --------------------------------
# Base URL used by server components and route handlers. Inside Docker
# Compose this is the service name; running natively it is localhost.
API_INTERNAL_BASE_URL=http://localhost:8000
